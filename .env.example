# Copy this file to .env and fill in your values before running docker-compose.
# NEVER commit a .env file with real secrets to version control.

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong random secret, e.g.:
#   openssl rand -hex 32
# Rotating this invalidates every issued token and logs all users out.
JWT_SECRET=

# REQUIRED: shared secret authenticating the internal registration sync from
# auth-service to user-service's /sync-user. That endpoint runs before the new
# user has a token, so it cannot use a normal JWT. Both services refuse to
# start without it. Generate one the same way as JWT_SECRET:
#   openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED. Used for two things that must agree, and docker-compose derives both
# from these variables so they cannot drift:
#   1. MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD on the mongodb
#      container, which create the root user on FIRST initialisation only
#   2. the MONGO_URI of auth-service, user-service and post-service
#
# Because MONGO_INITDB_* applies only on first initialisation, set the password
# BEFORE the first start. Changing it later requires recreating the volume:
#   docker compose -f docker-compose.microservices.yml down -v   (DESTROYS DATA)
#
# Avoid @ : / ? # and % in the password: it is embedded in a MongoDB connection
# URI without percent-encoding, so those characters break the URI.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Required for image uploads (post images and profile pictures).
# Create a project at https://supabase.com, then:
#   1. Go to Storage → create a bucket named "uploads" (set to Public for public URLs)
#   2. Copy the Project URL and service-role key from Settings → API
# NEVER commit the service-role key — it has admin access to your project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=uploads

# ─── Service URLs (only needed for local bare-Node dev, not Docker) ────────────
# AUTH_SERVICE_URL=http://localhost:3001
# USER_SERVICE_URL=http://localhost:3002
# POST_SERVICE_URL=http://localhost:3003
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200

# ─── Base64 image migration (scripts/migrate-base64-images.js only) ───────────
# Needed only when migrating legacy base64 images out of MongoDB.
# Posts and profiles live in SEPARATE databases, so both URIs are required.
# See docs/supabase-setup.md for the full procedure.
# Substitute the same credentials you set above; there is no default password.
# POST_MONGO_URI=mongodb://<user>:<password>@localhost:27017/post-service?authSource=admin
# USER_MONGO_URI=mongodb://<user>:<password>@localhost:27017/user-service?authSource=admin
